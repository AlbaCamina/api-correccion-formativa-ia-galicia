# Configuración básica de API de Corrección Formativa con IA
# Copia este archivo a ".env" y configura tus claves de API

# Proveedor de Inteligencia Artificial (opciones: openai, groq, mock)
LLM_PROVIDER=mock

# Clave API de Groq (necesaria si LLM_PROVIDER=groq)
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Clave API de OpenAI (necesaria si LLM_PROVIDER=openai)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Clave API de Anthropic (reservada para futuras fases si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Modelo a utilizar por defecto en el LLM
LLM_MODEL=llama-3.3-70b-versatile

# Conexión a Base de Datos PostgreSQL (v0.2)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/api_correccion_galicia


