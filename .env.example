# Configuración básica de API de Corrección Formativa con IA
# Copia este archivo a ".env" y añade tus claves de API (nunca subas .env a Git)

# Proveedor de Inteligencia Artificial (opciones: groq, openai, anthropic, mock)
LLM_PROVIDER=groq

# Clave API de Groq (necesaria si LLM_PROVIDER=groq) - Obtén tu clave gratis en https://console.groq.com
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Clave API de OpenAI (necesaria si LLM_PROVIDER=openai)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Clave API de Anthropic (necesaria si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Modelo a utilizar por defecto en pruebas (ej. llama-3.3-70b-versatile para groq, gpt-4o-mini para openai)
LLM_MODEL=llama-3.3-70b-versatile
